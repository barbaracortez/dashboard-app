{
  "name": "nexo-crm-dashboard",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Panel comercial (CRM) demo con React, Vite y Recharts",
  "scripts": {
    "dev": "vite",
    "dev:api": "vite --mode api",
    "server": "json-server --watch db.json --port 5000",
    "db:seed": "node scripts/generate-db.js",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "build:pages": "vite build --base=/dashboard-app/ && node -e \"require('fs').copyFileSync('dist/index.html','dist/404.html')\"",
    "deploy": "npm run build:pages && gh-pages -d dist -m \"Deploy demo\""
  },
  "homepage": "https://barbaracortez.github.io/dashboard-app/",
  "dependencies": {
    "lucide-react": "^1.73.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-is": "^19.1.0",
    "react-router-dom": "^7.6.2",
    "recharts": "^3.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "gh-pages": "^6.3.0",
    "globals": "^16.0.0",
    "json-server": "^0.17.4",
    "vite": "^6.3.5"
  }
}
